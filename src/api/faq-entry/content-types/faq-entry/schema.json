{
  "kind": "collectionType",
  "collectionName": "faq_entries",
  "info": {
    "singularName": "faq-entry",
    "pluralName": "faq-entries",
    "displayName": "faq-entry"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "richtext"
    },
    "isTop": {
      "type": "boolean",
      "default": false
    },
    "section": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::faq-section.faq-section",
      "inversedBy": "faq_entries"
    }
  }
}
