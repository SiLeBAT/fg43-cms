{
  "kind": "collectionType",
  "collectionName": "faq_sections",
  "info": {
    "singularName": "faq-section",
    "pluralName": "faq-sections",
    "displayName": "faq-section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "faq_entries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq-entry.faq-entry",
      "mappedBy": "section"
    },
    "Priority": {
      "type": "biginteger"
    }
  }
}
